# Supabase project shared with the main app. Server-side only — the waitlist
# server action inserts via PostgREST with the anon (publishable) key.
SUPABASE_URL="https://tjanjtijyjrpmzhtevou.supabase.co"
SUPABASE_ANON_KEY=""

# Search. The site is indexable by default; set this to false only on a
# staging copy that must stay out of search results.
# ALLOW_INDEXING=false

# Ownership tokens from Google Search Console ("HTML tag" method: the content
# value only) and Bing Webmaster Tools. Optional.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
